rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita para o estado da aplicação e dados da reativação
    match /app_state/{document} {
      allow read, write: if true;
    }

    match /campaign_config/{document} {
      allow read, write: if true;
    }

    match /imported_clients/{document} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
